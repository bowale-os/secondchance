# cloud = Spectrum Cloud (iMessage, with SMS/RCS where your plan allows)
# terminal = local chat UI, no Photon account needed
TEXTBOT_MODE=terminal

# From app.photon.codes. Keep in the secrets manager, never in a shared doc.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# FastAPI backend and the shared secret (same value as backend BOT_SERVICE_SECRET)
BACKEND_URL=http://localhost:3000
BOT_SERVICE_SECRET=

# Internal port for backend -> sidecar proactive sends (POST /send). Don't expose publicly.
TEXTBOT_PORT=8787

# After sign-in, merge messages sent within this many ms into one turn (0 = never merge)
MERGE_WINDOW_MS=2500

# Photos waiting for sign-in, a 1/2 choice, or SAVE are kept in memory this long (ms)
PHOTO_HOLD_MS=600000

# Terminal mode only: the phone number your terminal messages pretend to come from.
# Enroll this number on a test client in ClientPage.
TEST_SENDER_PHONE=+14045550100
