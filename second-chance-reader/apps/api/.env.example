# Copy to .env and fill in. Never commit .env.

PORT=8787
# fake = sample responses, no cost (default). claude = real Claude calls.
AI_MODE=fake
# Needed only when AI_MODE=claude.
ANTHROPIC_API_KEY=
# Browser origins allowed to call the API (the Expo web dev server by default).
CORS_ORIGINS=http://localhost:8081

# TODO(cloud): filled in once the AWS setup checklist is done.
AWS_REGION=
S3_BUCKET=
DDB_TABLE=
KMS_KEY_ID=
COGNITO_USER_POOL_ID=
