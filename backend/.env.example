# ============================================================
# Reentry Support Platform — environment variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git (add it to .gitignore).
# ============================================================

# ---------- App ----------
NODE_ENV=development
APP_NAME=SecondChance
APP_BASE_URL=http://localhost:5173          # front end (React/Vite)
API_BASE_URL=http://localhost:3000          # back end API
PORT=3000
DEFAULT_LANGUAGE=en
LOCAL_TIMEZONE=America/New_York         # schedules are shown in this zone
SUPPORTED_LANGUAGES=en,es

# ---------- Security ----------
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me
PIN_PEPPER=change-me                        # extra secret mixed into hashed client PINs
DATA_ENCRYPTION_KEY=change-me               # 32-byte hex key for encrypting sensitive fields
SESSION_TIMEOUT_MINUTES=10                  # auto log-out after inactivity
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
TRANSCRIPT_RETENTION_DAYS=30                # auto-delete call/text transcripts
ABANDONED_UPLOAD_HOURS=24                   # cleanup job deletes unattached uploads older than this

# ---------- AI: document reader + agent brain ----------
# Pick one provider for each job: anthropic | gemini | bedrock
DOC_READER_PROVIDER=anthropic
AGENT_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-opus-5-5

# Gemini (Hacklanta "Best Use of Gemini API")
GEMINI_API_KEY=xxxxxxxx
GEMINI_MODEL=your-gemini-model-name

# ---------- Phone line: Twilio (text + voice) ----------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_PHONE_NUMBER=+15555550123            # regular 10-digit number, not a short code
TWILIO_WEBHOOK_URL=https://your-api-url/twilio   # public URL Twilio calls (use ngrok locally)

# ---------- Voice: ElevenLabs (Hacklanta "Best Use of ElevenLabs") ----------
ELEVENLABS_API_KEY=xxxxxxxx
ELEVENLABS_VOICE_ID_EN=xxxxxxxx
ELEVENLABS_VOICE_ID_ES=xxxxxxxx
ELEVENLABS_AGENT_ID=xxxxxxxx                # if using an ElevenLabs voice agent

# ---------- Login for staff: Auth0 (Hacklanta "Best Use of Auth0") ----------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=xxxxxxxx
AUTH0_CLIENT_SECRET=xxxxxxxx
AUTH0_AUDIENCE=https://your-api-identifier
# Roles defined in Auth0: case_worker, parole_officer, org_admin

# Front end copies (Vite only exposes vars starting with VITE_)
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=xxxxxxxx
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# ---------- AWS (database, file storage, scheduled reminders) ----------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxx
DYNAMODB_TABLE_PREFIX=reentry_dev_          # tables: clients, events, documents, sharing, access_log
S3_DOCUMENTS_BUCKET=reentry-dev-documents
KMS_KEY_ID=xxxxxxxx                         # encrypts S3 + DynamoDB

# ---------- Optional sponsor alternatives ----------
# Tiger Data (Postgres) instead of DynamoDB
DATABASE_URL=postgres://user:password@host:5432/reentry

# Vultr hosting / object storage instead of AWS
VULTR_API_KEY=xxxxxxxx
VULTR_OBJECT_STORAGE_ENDPOINT=https://ewr1.vultrobjects.com
VULTR_OBJECT_STORAGE_ACCESS_KEY=xxxxxxxx
VULTR_OBJECT_STORAGE_SECRET_KEY=xxxxxxxx
VULTR_BUCKET=reentry-documents

# ---------- Maps / directions to resources ----------
MAPS_API_KEY=xxxxxxxx                       # e.g. Google Maps for directions + transit times

# ---------- Resources data ----------
RESOURCES_FILE=./data/resources.json        # hand-checked list of shelters, food banks, clinics, jobs

# ---------- Safety ----------
CRISIS_LINE=988
EMERGENCY_NUMBER=911HELP_LINE=211

# ---------- Text bot (Photon Spectrum sidecar) ----------
BOT_SERVICE_SECRET=xxxxxxxx                 # long random string; same value in textbot/.env
TEXTBOT_URL=http://localhost:8787           # sidecar's internal /send endpoint
BOT_IDLE_MINUTES=15
BOT_SESSION_MAX_HOURS=3
BOT_MAX_FAILED_ATTEMPTS=5
